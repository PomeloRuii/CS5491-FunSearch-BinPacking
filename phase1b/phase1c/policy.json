  "ulimits": {"cpu": [5, 6], "nofile": [64, 64], "core": [0, 0], "fsize": [1048576, 1048576]},
  "execution_wall_seconds": 30,
  "daemon_operation_timeout_seconds": 15,
  "combined_output_limit_bytes": 65536,
  "host_bind_mounts": [],
  "host_environment_passthrough": [],
  "gpu_access": false,
  "privileged": false,
  "container_reuse": false,
  "image_reference": "require_an_existing_local_immutable_sha256_image_id"
}

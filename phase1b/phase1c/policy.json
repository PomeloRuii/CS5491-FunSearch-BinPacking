{
  "schema_version": 1,
  "backend": "hardened_disposable_linux_container",
  "execution_scope": "reviewed_fixed_probes_only",
  "generated_code_execution_enabled": false,
  "network": "none",
  "user": "65532:65532",
  "read_only_root": true,
  "cap_drop": ["ALL"],
  "no_new_privileges": true,
  "seccomp": "Docker_default_required",
  "cgroup_namespace": "private",
